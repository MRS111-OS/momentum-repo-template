# Testing-specific Dockerfile for CI/CD
# Optimized for running tests and generating reports

ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}

ENV WORKSPACE=/home/ros/ws
ENV DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO

RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pytest \
    python3-pytest-cov \
    python3-pytest-xdist \
    ros-${ROS_DISTRO}-ament-flake8 \
    ros-${ROS_DISTRO}-ament-black \
    ros-${ROS_DISTRO}-ament-mypy \
    ros-${ROS_DISTRO}-ament-pep257 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p ${WORKSPACE}/src
WORKDIR ${WORKSPACE}

# Copy repo
COPY . src/repository

# Install dependencies
RUN rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y || true

RUN pip install --break-system-packages --upgrade pip && \
    if [ -f src/repository/requirements.txt ]; then \
        pip install --break-system-packages -r src/repository/requirements.txt; \
    fi && \
    pip install --break-system-packages coverage

# Build all packages in the workspace
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && \
    echo "=== Building all packages in workspace ===" && \
    colcon build \
    --symlink-install \
    --event-handlers console_direct+ \
    --parallel-workers 4 \
    2>&1 | tee build.log

# Run tests with coverage and reports
RUN mkdir -p /test-results

CMD ["/bin/bash", "-lc", "\
set -e; \
source /opt/ros/${ROS_DISTRO}/setup.bash; \
source ${WORKSPACE}/install/setup.bash; \
\
if [ \"${ROS_TEST_MODE:-colcon-test}\" = \"launch\" ]; then \
    if [ -z \"${ROS_LAUNCH_COMMAND}\" ]; then \
        echo 'ROS_TEST_MODE=launch requires ROS_LAUNCH_COMMAND'; \
        exit 1; \
    fi; \
\
    DURATION=${ROS_LAUNCH_DURATION_SECONDS:-30}; \
    echo \"=== Running launch command for ${DURATION}s ===\"; \
\
    set +e; \
    timeout \"${DURATION}\" bash -lc \"${ROS_LAUNCH_COMMAND}\" 2>&1 | tee /test-results/launch.log; \
    LAUNCH_STATUS=${PIPESTATUS[0]}; \
    set -e; \
\
    if [ ${LAUNCH_STATUS} -ne 0 ] && [ ${LAUNCH_STATUS} -ne 124 ]; then \
        echo \"Launch command failed with status ${LAUNCH_STATUS}\"; \
        exit ${LAUNCH_STATUS}; \
    fi; \
\
    echo '=== Launch run complete ===' | tee /test-results/test-results.txt; \
else \
    echo '=== Running ROS Tests ==='; \
    colcon test --event-handlers console_direct+ --return-code-on-test-failure 2>&1 | tee /test-results/colcon-test.log; \
    echo '=== Test Results ==='; \
    colcon test-result --verbose 2>&1 | tee /test-results/test-results.txt; \
fi; \
\
echo '=== Running Python Unit Tests ==='; \
PYTEST_TARGET=${WORKSPACE}/src/repository; \
if find ${WORKSPACE}/src -name 'test_*.py' -o -name '*_test.py' | grep -q .; then \
    find ${WORKSPACE}/src -name 'test_*.py' -o -name '*_test.py' | xargs pytest -v --tb=short --cov=${PYTEST_TARGET} --cov-report=xml:/test-results/coverage.xml 2>&1 | tee /test-results/pytest.log; \
else \
    echo 'No Python tests found in workspace.' | tee /test-results/pytest.log; \
fi; \
\
echo '=== Running Code Quality Checks ==='; \
ament_flake8 ${WORKSPACE}/src/repository 2>&1 | tee /test-results/flake8.log || true; \
\
echo '=== All Tests Complete ==='; \
echo 'Test reports available in /test-results/'\
"]
